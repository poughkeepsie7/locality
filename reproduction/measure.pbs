#!/bin/bash
set -eo pipefail

cd /home/student4/BT2024135/locality
exec > "reproduction/runs/${PBS_JOBID}.log" 2>&1
module purge
module load mpi/openmpi-2.1.1

echo "Job $PBS_JOBID"
sort "$PBS_NODEFILE" | uniq -c
lscpu -p=CPU,CORE,SOCKET
mpirun --version

mkdir -p "reproduction/runs/$PBS_JOBID"
build="$PWD/reproduction/runs/$PBS_JOBID"
for src in src/collective/{allgather,gather,bcast}.c src/{communicator,utils}/*.c; do
    [ -f "$src" ] || continue
    mpicc -O3 -g -std=gnu99 -I src -I src/collective -c "$src" -o "$build/$(basename "${src%.c}").o"
done
mpic++ -O3 -g -std=c++11 -I src -I src/collective reproduction/measure.cpp src/utils/utils.cpp "$build"/*.o -o "$build/measure"
for config in $SWEEP_PPN; do
    ppn="${config%%:*}"
    mode=core
    if [[ "$config" == *:* ]]; then mode="${config#*:}"; fi
    echo "START,$SWEEP_NODES,$ppn"
    binding=(--bind-to core)
    mapping="ppr:$ppn:node"
    if [ "$ppn" -eq 32 ]; then mode=smt; fi
    if [[ "$mode" == *smt ]]; then
        binding=(--use-hwthread-cpus --bind-to hwthread)
    fi
    if [[ "$mode" == socket_* ]]; then mapping="ppr:$ppn:socket"; fi
    if [ "$mode" = socket_core ] && ! lscpu -p=CORE,SOCKET | awk -F, -v ppn="$ppn" '!/^#/ && !seen[$1,$2]++ { cores[$2]++ } END { for (socket in cores) if (cores[socket] >= ppn) exit 0; exit 1 }'; then
        echo "UNAVAILABLE,$SWEEP_NODES,$ppn,$mode"
        continue
    fi
    output="$build/$ppn.$mode.log"
    if timeout -k 5 60 mpirun --prefix /opt/apps/mpi/openmpi-2.1.1 \
            --mca plm_rsh_agent '/bin/ssh -o BatchMode=yes' \
            --mca btl self,vader,tcp --map-by "$mapping" \
            --rank-by slot "${binding[@]}" --hostfile "$PBS_NODEFILE" \
            -np "$((SWEEP_NODES * ppn))" "$build/measure" "$SWEEP_NODES" "$ppn" "$mode" 2>&1 | tee "$output" &&
            grep -qx "VERIFIED,$SWEEP_NODES,$ppn" "$output"; then
        echo "DONE,$SWEEP_NODES,$ppn"
    else
        echo "FAILED,$SWEEP_NODES,$ppn"
    fi
done
